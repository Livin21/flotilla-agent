<?php
// require_once, NOT require: Unraid evaluates a .page's content more than once within a single
// request (DefaultPageLayout eval's page text, and the tabless/panel renderer walks $pages
// again), so a plain `require` re-executes settings.php's function declarations and PHP dies
// with "Cannot redeclare function flotilla_b64url()". That is a COMPILE-time fatal, not a
// catchable Throwable, so evalContent.php's try/catch never sees it, nothing reaches
// console.error, and the settings page just renders empty from that point on -- with the page
// title still drawn above it, because the title is emitted before the content eval. Caught only
// by loading the real page in a browser after a genuine install; CLI includes it exactly once,
// so every command-line check passes.
require_once '/usr/local/emhttp/plugins/flotilla-agent/include/settings.php';
// I10: self-heal the heartbeat cron entry on every page load, paired or not -- this is the
// earliest point after a fresh install a user is guaranteed to reach (it's literally where
// pairing happens), well before the next reboot or another plugin's install would otherwise
// trigger Unraid's update_cron and pick up the entry the .plg's own install-time call missed
// (see flotilla_reassert_cron()'s doc comment in settings.php for the registration-ordering
// reason). Silent, idempotent, and cheap: a no-op once the entry's already registered.
flotilla_reassert_cron();
$cronOk = flotilla_cron_ok();
$cfg = flotilla_read_cfg(); $paired = $cfg['PAIRING_ID'] !== '';
$csrf = flotilla_csrf_token();
$csrfField = '<input type="hidden" name="csrf_token" value="' . htmlspecialchars($csrf !== false ? $csrf : '') . '">';
// I7: explode()'s second argument must be a string -- PHP 8 (which Unraid 7 ships) throws an
// uncaught TypeError, not a warning, if it isn't. isset() alone was not enough: a crafted
// /Settings/FlotillaAgent?err[]=x hands this an array and 500s the settings page.
$errList = is_string($_GET['err'] ?? null) ? explode(',', $_GET['err']) : [];
// Task 13 §8: only meaningful once paired (heartbeat.sh -- and therefore the header capture
// it does -- only ever runs against a real pairing). flotilla_min_agent_notice() itself
// already fails closed to null on any missing/malformed input, never fatals.
$minAgentNotice = $paired ? flotilla_min_agent_notice(FLOTILLA_AGENT_VERSION) : null;
// I6: only meaningful once paired -- shows whether Unraid's own [notify] entity bits (which
// Unraid's own Settings → Notifications page can silently clear) still let Flotilla's notify
// shim run at all. null (dynamix.cfg unreadable/unparsable) shows nothing rather than a
// false alarm.
$entitiesOk = $paired ? flotilla_entities_ok() : null;
$FL_EP = '/plugins/flotilla-agent/include/settings.php';
?>
<script src="/plugins/flotilla-agent/js/qrcode.min.js"></script>
