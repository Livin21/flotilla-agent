<?php endif; ?>
<?php if ($cronOk !== null): ?>
<div class="fl-row"><span class="fl-dot <?= $cronOk ? 'fl-ok' : 'fl-bad' ?>"></span>Heartbeat scheduled: <b><?= $cronOk ? 'yes' : 'no' ?></b>
