Menu="Utilities"
Title="Flotilla Agent"
Icon="bell"
---
<?php require '/usr/local/emhttp/plugins/flotilla-agent/include/settings.php';
$cfg = flotilla_read_cfg(); $paired = $cfg['PAIRING_ID'] !== '';
$csrf = flotilla_csrf_token();
$csrfField = '<input type="hidden" name="csrf_token" value="' . htmlspecialchars($csrf !== false ? $csrf : '') . '">';
$errList = isset($_GET['err']) ? explode(',', $_GET['err']) : [];
// Task 13 §8: only meaningful once paired (heartbeat.sh -- and therefore the header capture
// it does -- only ever runs against a real pairing). flotilla_min_agent_notice() itself
// already fails closed to null on any missing/malformed input, never fatals.
$minAgentNotice = $paired ? flotilla_min_agent_notice(FLOTILLA_AGENT_VERSION) : null;
// I6: only meaningful once paired -- shows whether Unraid's own [notify] entity bits (which
// Unraid's own Settings → Notifications page can silently clear) still let Flotilla's notify
// shim run at all. null (dynamix.cfg unreadable/unparsable) shows nothing rather than a
// false alarm.
$entitiesOk = $paired ? flotilla_entities_ok() : null;
?>
<script src="/plugins/flotilla-agent/js/qrcode.min.js"></script>
<div style="max-width:640px">
<h3>Flotilla Push</h3>
<?php if (in_array('relay', $errList, true)): ?><p style="color:red">Relay URL was invalid — kept the previous value.</p><?php endif; ?>
<?php if (in_array('level', $errList, true)): ?><p style="color:red">Minimum importance value was invalid — kept the previous value.</p><?php endif; ?>
<?php if (!$paired): ?>
<p>Pair this server with the Flotilla iOS app. Pairing generates an end-to-end encryption key that never leaves your network except inside the QR code below.</p>
<form method="post"><input type="hidden" name="action" value="pair"><?= $csrfField ?><button type="submit">Pair with Flotilla…</button></form>
<?php else: ?>
<p><b>Paired.</b> Scan from Flotilla → Settings → Notifications → Add server. Anyone who can see this QR can read your alerts — treat it like a password.</p>
<?php if ($minAgentNotice !== null): ?>
<p style="color:orange"><b>Update needed:</b> the relay requires agent ≥ <?= htmlspecialchars($minAgentNotice) ?> — this install is <?= htmlspecialchars(FLOTILLA_AGENT_VERSION) ?>. Update the plugin from Community Applications.</p>
<?php endif; ?>
<?php if ($entitiesOk !== null): ?>
<p>Unraid will deliver warnings/alerts to Flotilla: <b style="color:<?= $entitiesOk ? 'lightgreen' : 'red' ?>"><?= $entitiesOk ? 'yes' : 'no' ?></b>
<?php if (!$entitiesOk): ?> — Unraid's own notification settings turned this off. <form method="post" style="display:inline"><input type="hidden" name="action" value="repair_entities"><?= $csrfField ?><button type="submit">Repair</button></form><?php endif; ?></p>
<?php endif; ?>
<div id="qr"></div>
<script>new QRCode(document.getElementById("qr"), {text: <?= json_encode(flotilla_pair_url($cfg)) ?>, width: 240, height: 240});</script>
<p>Manual code:</p><textarea readonly rows="3" style="width:100%"><?= htmlspecialchars(flotilla_pair_url($cfg)) ?></textarea>
<form method="post" style="margin-top:12px"><input type="hidden" name="action" value="test"><?= $csrfField ?><button type="submit">Send test notification</button></form>
<form method="post"><input type="hidden" name="action" value="save"><?= $csrfField ?>
  <h4>Filters</h4>
  <label>Minimum importance:
  <select name="LEVEL_MIN">
    <option value="normal"  <?= $cfg['LEVEL_MIN'] === 'normal'  ? 'selected' : '' ?>>All (notices too)</option>
    <option value="warning" <?= $cfg['LEVEL_MIN'] === 'warning' ? 'selected' : '' ?>>Warnings & alerts</option>
    <option value="alert"   <?= $cfg['LEVEL_MIN'] === 'alert'   ? 'selected' : '' ?>>Alerts only</option>
  </select></label><br>
  <label><input type="checkbox" name="CAT_DISKS" value="yes" <?= $cfg['CAT_DISKS'] === 'yes' ? 'checked' : '' ?>> Disk events (temperature, SMART, utilization)</label><br>
  <label><input type="checkbox" name="CAT_ARRAY" value="yes" <?= $cfg['CAT_ARRAY'] === 'yes' ? 'checked' : '' ?>> Array & parity events</label><br>
  <label><input type="checkbox" name="CAT_OTHER" value="yes" <?= $cfg['CAT_OTHER'] === 'yes' ? 'checked' : '' ?>> Everything else (plugins, status reports)</label><br>
  <h4>Advanced</h4>
  <label>Relay URL: <input type="text" name="RELAY" value="<?= htmlspecialchars($cfg['RELAY']) ?>" style="width:100%"></label>
  <p style="opacity:.7">The relay forwards encrypted payloads it cannot read. Self-hosters can point this at their own deployment.</p>
  <button type="submit">Save</button>
</form>
<form method="post" onsubmit="return confirm('Reset pairing? All paired devices stop receiving pushes until they re-scan.')">
  <input type="hidden" name="action" value="reset"><?= $csrfField ?><button type="submit" style="color:red">Reset pairing</button></form>
<?php endif; ?>
</div>
